{
  "name": "zipper",
  "version": "0.1.0",
  "description": "Windows 11 の佇まいに馴染む多形式アーカイバ",
  "main": "./out/main/index.js",
  "author": "stiz",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:win": "npm run typecheck && npm run make:icon && npm run build:shell && npm run build:package && electron-vite build && electron-builder --win --publish never",
    "fetch:7zip": "node scripts/fetch-7zip.mjs",
    "make:icon": "node scripts/make-icon.mjs",
    "build:shell": "cmd /c native\\shellext\\build.bat",
    "build:package": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/make-package.ps1",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^13.1.1",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
