<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows 11 の新しい右クリックメニューへ項目を出すための、外皮だけのパッケージ。
  実体はインストール先に置いたままで、登録時に -ExternalLocation で場所を教える。
  Publisher は署名に使う証明書の Subject と一致させること。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity
    Name="Zipper.ShellExtension"
    Publisher="CN=Zipper Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Zipper</DisplayName>
    <PublisherDisplayName>Zipper</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="ja-JP" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application
      Id="Zipper"
      Executable="Zipper.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">

      <uap:VisualElements
        DisplayName="Zipper"
        Description="Windows 11 の佇まいに馴染む多形式アーカイバ"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- 右クリックの項目を組み立てる COM サーバー -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Zipper Shell Extension">
              <com:Class
                Id="C8C609B0-DF39-49D5-B1FB-3FBED19D3B54"
                Path="resources\shell\ZipperShell.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- すべてのファイルとフォルダに出す。中身の出し分けは DLL 側で行う -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Zipper" Clsid="C8C609B0-DF39-49D5-B1FB-3FBED19D3B54" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Zipper" Clsid="C8C609B0-DF39-49D5-B1FB-3FBED19D3B54" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
